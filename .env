# Copy to .env. In Polar: click a node > Connect tab > copy REST host + "Admin Macaroon" path.
# Alice and Bob are the two users. Carol is the vault and Bitmsika gateway.
ALICE_REST=https://127.0.0.1:8081
ALICE_MACAROON=C:\Users\ADMIN\.polar\networks\3\volumes\lnd\alice\data\chain\bitcoin\regtest\admin.macaroon
BOB_REST=https://127.0.0.1:8082
BOB_MACAROON=C:\Users\ADMIN\.polar\networks\3\volumes\lnd\bob\data\chain\bitcoin\regtest\admin.macaroon
CAROL_REST=https://127.0.0.1:8083
CAROL_MACAROON=C:\Users\ADMIN\.polar\networks\3\volumes\lnd\carol\data\chain\bitcoin\regtest\admin.macaroon
# Demo exchange rate (MWK per 1 BTC)
MWK_PER_BTC=160000000
